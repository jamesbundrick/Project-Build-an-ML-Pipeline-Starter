{% set name = "pyproject_hooks" %}
{% set version = "1.2.0" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz
  sha256: 1e859bd5c40fae9448642dd871adf459e5e2084186e8d2c2a79a824c970da1f8

build:
  skip: true  # [py<37]
  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation
  number: 1

requirements:
  host:
    - python
    - pip
    - flit-core >=3.2,<4
  run:
    - python

test:
  imports:
    - pyproject_hooks
  source_files:
    - tests
  requires:
    - pip
    - pytest
    - testpath
    - setuptools >=30
    - tomli >=1.1.0  # [py<311]
  commands:
    - pip check
    - pytest -v tests/

about:
  home: https://github.com/pypa/pyproject-hooks
  summary: Wrappers to call pyproject.toml-based build backend hooks.
  description: |
    This is a low-level library for calling build-backends
    in pyproject.toml-based project. It provides the basic functionality
    to help write tooling that generates distribution files from Python projects.
  dev_url: https://github.com/pypa/pyproject-hooks
  license: MIT
  license_file: LICENSE
  license_family: MIT
  doc_url: https://pyproject-hooks.readthedocs.io

extra:
  recipe-maintainers:
    - theAeon
